{
  "name": "@ccda-kit/react-native",
  "version": "0.0.0",
  "description": "React Native bindings for ccda-kit C-CDA parsing and rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccda-tools/ccda-kit.git",
    "directory": "react-native"
  },
  "main": "lib/commonjs/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "android/build.gradle",
    "android/src/main",
    "ios/*.{h,m,mm,swift}",
    "ios/*.rb",
    "ios/Tests/*.m",
    "src/index.ts",
    "src/types.ts",
    "src/native.ts",
    "src/theme.ts",
    "src/formatting.ts",
    "src/components",
    "lib/commonjs",
    "lib/typescript",
    "LICENSE",
    "TESTING.md",
    "ccda-kit-react-native.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "ccda",
    "c-cda",
    "healthcare",
    "react-native"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.74.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.7",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.88.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.0"
  },
  "react-native": "src/index.ts"
}
